# ==============================================================================
# AI Dev Team — Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Required for AI Agents)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g. gemini-2.5-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Redis Connection URL (Optional - uses persistent file checkpointer .checkpoints.json if omitted)
REDIS_URL=redis://localhost:6379

# Express Server Port
SERVER_PORT=4000

# Frontend URL (For CORS and WebSocket origin verification)
FRONTEND_URL=http://localhost:5173

# Default Project Token Budget (in USD)
TOKEN_BUDGET=2.0

# JWT Secret for Session Cookies and WebSocket Authentication
JWT_SECRET=your_jwt_secret_key_here

# (Optional) Google OAuth 2.0 Client ID for Google Single Sign-On
GOOGLE_CLIENT_ID=
