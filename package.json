    "test:pm": "node tests/test-pm-agent.js",
    "test:architect": "node tests/test-architect.js",
    "test:validator": "node tests/test-validator.js",
    "test:planner": "node tests/test-planner.js",
    "test:sandbox": "node tests/test-sandbox.js",
    "test:devloop": "node tests/test-devloop.js",
    "test:auth": "node tests/test-auth.js",
    "test:resume": "node tests/test-resume.js",
    "test:pm:clarification": "node tests/test-pm-clarification.js",
    "test:planner:integration": "node tests/test-planner-integration.js",
    "test:projects": "node tests/test-my-projects.js",
    "test:final": "node tests/test-final-production.js",
    "test:all:mock": "node tests/test-graph-skeleton.js && node tests/test-validator.js && node tests/test-devloop.js && node tests/test-auth.js && node tests/test-my-projects.js && node tests/test-resume.js && node tests/test-planner-integration.js"
  },
  "dependencies": {
